    {
      "name": "04 - Pedido",
      "item": [
        {
          "name": "Crear pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('pedidoId', body.id);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Estado inicial PENDIENTE', () => pm.expect(body.estado).to.eql('PENDIENTE'));",
                  "pm.test('Cliente completado por Feign', () => pm.expect(body.cliente.nombre).to.not.be.empty);",
                  "pm.test('Producto completado por Feign', () => pm.expect(body.producto.nombre).to.not.be.empty);",
                  "pm.test('Subtotal calculado', () => pm.expect(body.subtotal).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"productoId\": {{productoId}},\n  \"cantidad\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrlPedido}}/api/pedidos"
          }
