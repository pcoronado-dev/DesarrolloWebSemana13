                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Incluye datos del pedido', () => pm.expect(body.cantidad).to.eql(2));",
                  "pm.test('Incluye datos del cliente', () => pm.expect(body.cliente.apellidos).to.not.be.empty);",
                  "pm.test('Incluye datos del producto', () => pm.expect(body.producto.precio).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
