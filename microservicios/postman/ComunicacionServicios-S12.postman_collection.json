  "item": [
    {
      "name": "01 - Categoria",
      "item": [
        {
          "name": "Crear categoria",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('categoriaId', body.id);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Devuelve id y estado ACTIVO', () => {",
                  "  pm.expect(body.id).to.be.a('number');",
                  "  pm.expect(body.estado).to.eql('ACTIVO');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tecnologia\",\n  \"estado\": \"ACTIVO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrlCategoria}}/api/categorias"
          }
        },
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrlCategoria}}/api/categorias"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Obtener categoria por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrlCategoria}}/api/categorias/{{categoriaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Nombre no vacio', () => pm.expect(pm.response.json().nombre).to.not.be.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Actualizar categoria",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Tecnologia y Computo\",\n  \"estado\": \"ACTIVO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrlCategoria}}/api/categorias/{{categoriaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Nombre actualizado', () => pm.expect(pm.response.json().nombre).to.eql('Tecnologia y Computo'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Crear categoria temporal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('categoriaTemporalId', pm.response.json().id);",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Categoria temporal\",\n  \"estado\": \"INACTIVO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrlCategoria}}/api/categorias"
          }
        },
        {
          "name": "Eliminar categoria temporal",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrlCategoria}}/api/categorias/{{categoriaTemporalId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
